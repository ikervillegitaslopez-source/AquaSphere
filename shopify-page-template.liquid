<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AquaSphere™ | Premium Stainless Steel Portable Pet Water Bottle & Leaf Bowl</title>
  <meta name="description" content="Keep your pet hydrated on every walk with AquaSphere™. Insulated 304 food-grade stainless steel bottle with fold-out silicone leaf bowl. 100% leakproof, BPA-free, and travel-ready.">
  {{ 'style.css' | asset_url | stylesheet_tag }}
  <link rel="icon" type="image/png" href="images/logo.png">
</head>
<body>

  <!-- 1. SITE HEADER -->
  <header class="site-header">
    <div class="container header-container">
      <a href="#" class="logo">
        <img src="{{ 'logo.png' | asset_url }}" alt="AquaSphere Logo" class="brand-logo-img">
        <div>AquaSphere<span class="tm">™</span></div>
      </a>

      <div class="header-actions">
        <button id="cartHeaderBtn" class="cart-btn" aria-label="Shopping Cart">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="cart-badge">1</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 3. HERO / PRODUCT SECTION (Shopify Buy Box) -->
  <section class="product-hero" id="product">
    <div class="container">
      <div class="product-grid">

        <!-- Left Column: Gallery -->
        <div class="gallery-wrapper">
          <div class="gallery-main" id="mainGalleryBox">
            <span class="tag-save-badge">SAVE 50%</span>
            <img id="mainProductImg" src="{{ 'blue-closed.jpg' | asset_url }}" alt="AquaSphere Portable Pet Water Flask">
          </div>

          <!-- Thumbnails (4 Uploaded Views: Blue & Pink) -->
          <div class="gallery-thumbnails">
            <div class="thumb-item active" data-img="images/blue-closed.jpg">
              <img src="{{ 'blue-closed.jpg' | asset_url }}" alt="Pastel Blue Sphere Closed">
            </div>
            <div class="thumb-item" data-img="images/blue-in-use.jpg">
              <img src="{{ 'blue-in-use.jpg' | asset_url }}" alt="Corgi Drinking - Pastel Blue Bowl">
            </div>
            <div class="thumb-item" data-img="images/pink-closed.jpg">
              <img src="{{ 'pink-closed.jpg' | asset_url }}" alt="Blush Pink Sphere Closed">
            </div>
            <div class="thumb-item" data-img="images/pink-in-use.jpg">
              <img src="{{ 'pink-in-use.jpg' | asset_url }}" alt="Corgi Drinking - Blush Pink Bowl">
            </div>
          </div>
        </div>

        <!-- Right Column: Product Buy Box -->
        <div class="product-info">
          <div class="breadcrumbs">
            Home / Pet Travel / Hydration / <span>AquaSphere™ Flask</span>
          </div>

          <h1 class="product-title">
            <span class="title-line">AquaSphere™ Portable Stainless Steel</span>
            <span class="title-line">Pet Water Flask & Silicone Leaf Bowl</span>
          </h1>

          <!-- Reviews summary -->
          <div class="reviews-summary">
            <div class="stars-row">★★★★★</div>
            <div class="reviews-text">
              <strong>4.9 / 5.0</strong> (<a href="#reviews" class="verified-count">248 Verified Reviews</a>)
            </div>
          </div>

          <!-- Price Row -->
          <div class="price-row">
            <span class="current-price" id="currentPrice">$24.95</span>
            <span class="compare-price" id="comparePrice">$49.99</span>
          </div>

          <!-- Tiered Bundle Offers (AOV Booster) -->
          <div class="bundle-section">
            <div class="bundle-title">
              <span>Select Quantity & Save More:</span>
              <span style="font-size: 0.8rem; color: #10b981; font-weight: 700;">Free Shipping Included</span>
            </div>

            <div class="bundle-grid">
              <!-- Bundle 1 -->
              <div class="bundle-card selected" data-qty="1" data-price="24.95" data-compare="49.99" data-title="1x AquaSphere™">
                <div class="bundle-left">
                  <div class="custom-radio"></div>
                  <div>
                    <div class="bundle-info-title">1x AquaSphere™</div>
                    <div class="bundle-subtext">Only $24.95 each</div>
                  </div>
                </div>
                <div class="bundle-right">
                  <div class="bundle-price">$24.95</div>
                </div>
              </div>

              <!-- Bundle 2 (2-Pack Deal) -->
              <div class="bundle-card" data-qty="2" data-price="39.90" data-compare="99.98" data-title="2x AquaSphere™">
                <div class="bundle-left">
                  <div class="custom-radio"></div>
                  <div>
                    <div class="bundle-info-title">2x AquaSphere™</div>
                    <div class="bundle-subtext">Only $19.95 each</div>
                  </div>
                </div>
                <div class="bundle-right">
                  <div class="bundle-price">$39.90</div>
                  <div style="font-size: 0.75rem; color: #10b981; font-weight: 700;">Save $60.08</div>
                </div>
              </div>

              <!-- Bundle 3 (3-Pack Deal) -->
              <div class="bundle-card" data-qty="3" data-price="49.95" data-compare="149.97" data-title="3x AquaSphere™">
                <div class="bundle-left">
                  <div class="custom-radio"></div>
                  <div>
                    <div class="bundle-info-title">3x AquaSphere™</div>
                    <div class="bundle-subtext">Only $16.65 each</div>
                  </div>
                </div>
                <div class="bundle-right">
                  <div class="bundle-price">$49.95</div>
                  <div style="font-size: 0.75rem; color: #10b981; font-weight: 700;">Save $100.02</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Color Swatches (Only Blue and Pink) -->
          <div class="variant-section">
            <div class="variant-header">
              <strong>Color: <span id="selectedColorName" style="color: var(--primary);">Pastel Blue</span></strong>
              <span style="color: #10b981; font-size: 0.8rem; font-weight: 700;">✓ In Stock & Ready to Ship</span>
            </div>
            <div class="swatch-group">
              <button class="swatch-btn active" data-color="Pastel Blue" data-img="images/blue-closed.jpg" title="Pastel Blue">
                <div class="swatch-color" style="background: #7dd3fc; border: 1px solid #38bdf8;"></div>
              </button>
              <button class="swatch-btn" data-color="Blush Pink" data-img="images/pink-closed.jpg" title="Blush Pink">
                <div class="swatch-color" style="background: #f472b6; border: 1px solid #ec4899;"></div>
              </button>
            </div>
          </div>

          <!-- Quantity & Add to Cart -->
          <div class="cta-row">
            <div class="qty-control">
              <button class="qty-btn" id="qtyMinus" aria-label="Decrease quantity">-</button>
              <span class="qty-val" id="qtyValue">1</span>
              <button class="qty-btn" id="qtyPlus" aria-label="Increase quantity">+</button>
            </div>

            <button class="btn-add-cart" id="btnAddToCart">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span id="btnPriceText">ADD TO CART • $24.95</span>
            </button>
          </div>

          <!-- Accepted Payment Methods (Official Icons - 1 Line Across All Devices) -->
          <div class="payment-icons" aria-label="Accepted payment methods">
            <img src="{{ 'payments/visa.svg' | asset_url }}" alt="Visa" class="payment-icon-img" title="Visa" loading="lazy">
            <img src="{{ 'payments/master.svg' | asset_url }}" alt="Mastercard" class="payment-icon-img" title="Mastercard" loading="lazy">
            <img src="{{ 'payments/american_express.svg' | asset_url }}" alt="AMEX" class="payment-icon-img" title="American Express" loading="lazy">
            <img src="{{ 'payments/apple_pay.svg' | asset_url }}" alt="Apple Pay" class="payment-icon-img" title="Apple Pay" loading="lazy">
            <img src="{{ 'payments/google_pay.svg' | asset_url }}" alt="Google Pay" class="payment-icon-img" title="Google Pay" loading="lazy">
            <img src="{{ 'payments/shopify_pay.svg' | asset_url }}" alt="Shop Pay" class="payment-icon-img" title="Shop Pay" loading="lazy">
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- 4. CORE VALUE PILLARS -->
  <section class="features-section" id="benefits">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title pillars-title-single">Why Dogs & Owners Love AquaSphere™</h2>
        <p class="section-desc pillars-desc">
          <span class="pillars-desc-line">Traditional plastic bottles leak in your backpack, warm up in minutes,</span>
          <span class="pillars-desc-line">and release microplastics. AquaSphere™ redefines travel hydration</span>
          <span class="pillars-desc-line">with pure stainless steel and a fold-out silicone leaf.</span>
        </p>
      </div>

      <div class="pillars-grid">
        <!-- Pillar 1 -->
        <div class="pillar-card">
          <div class="pillar-icon">
            <img src="{{ 'icons/shield-water.png' | asset_url }}" alt="304 Stainless Steel Shield" class="pillar-icon-img">
          </div>
          <h3 class="pillar-title">304 Stainless Steel</h3>
          <p class="pillar-text">
            <span class="pillar-line">Unlike smelly plastic, insulated food-grade</span>
            <span class="pillar-line">304 steel keeps water icy cold for 12+ hours</span>
            <span class="pillar-line">and eliminates 99.9% of bacterial buildup.</span>
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="pillar-card">
          <div class="pillar-icon">
            <img src="{{ 'icons/leaf-bowl.png' | asset_url }}" alt="1-Second Leaf Bowl" class="pillar-icon-img">
          </div>
          <h3 class="pillar-title">1-Second Leaf Bowl</h3>
          <p class="pillar-text">
            <span class="pillar-line">Silky food-grade silicone leaf wraps seamlessly</span>
            <span class="pillar-line">around the sphere and instantly flips open</span>
            <span class="pillar-line">into a wide, ergonomic drinking cup.</span>
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="pillar-card">
          <div class="pillar-icon">
            <img src="{{ 'icons/icon-pillar3.png' | asset_url }}" alt="100% Leak-Proof Seal" class="pillar-icon-img">
          </div>
          <h3 class="pillar-title">100% Leak-Proof Seal</h3>
          <p class="pillar-text">
            <span class="pillar-line">Engineered silicone airtight gasket and</span>
            <span class="pillar-line">precision-machined threads. Toss it in your</span>
            <span class="pillar-line">backpack or bag with total confidence.</span>
          </p>
        </div>
      </div>
    </div>
  </section>


