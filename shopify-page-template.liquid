  <!-- 8. HOW IT WORKS (3 SIMPLE STEPS) -->
  <section class="steps-section" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title steps-title-single">Hydration in 3 Simple Steps</h2>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3 class="step-title">Flip the Leaf</h3>
          <p class="step-desc">
            <span class="step-line">Peel the soft silicone leaf backwards. It snaps into</span>
            <span class="step-line">a sturdy, wide drinking trough in under a second.</span>
          </p>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <h3 class="step-title">Pour Fresh Water</h3>
          <p class="step-desc">
            <span class="step-line">Loosen the leakproof twist cap slightly. Watch crisp,</span>
            <span class="step-line">cool water flow smoothly into the leaf bowl for your dog.</span>
          </p>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <h3 class="step-title">Fold & Continue</h3>
          <p class="step-desc">
            <span class="step-line">Tighten the cap, fold the leaf back onto the steel sphere,</span>
            <span class="step-line">clip it to your wrist or bag, and enjoy your hike!</span>
          </p>
        </div>
      </div>
    </div>
  </section>

