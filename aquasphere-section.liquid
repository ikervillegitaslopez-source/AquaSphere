  }
  .comp-table td {
    padding: 13px 16px;
    font-size: 0.88rem;
  }
  .comp-icon {
    width: 16px;
    height: 16px;
  }
  .comp-check {
    font-size: 1rem;
  }
  .comp-cross {
    font-size: 0.95rem;
  }
}

