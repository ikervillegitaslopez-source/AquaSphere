  }
  .col-features {
    padding-left: 6px !important;
    text-align: left !important;
  }
  .col-aquasphere, .col-plastic {
    padding: 10px 3px !important;
    text-align: center !important;
  }
  .comp-table td {
    padding: 9px 3px;
    font-size: clamp(0.58rem, 2.25vw, 0.72rem);
    line-height: 1.25;
  }
  .cell-feature {
    padding-left: 6px !important;
    text-align: left;
  }
  .cell-aquasphere, .cell-plastic {
    text-align: center;
    padding: 9px 2px !important;
  }
  .comp-icon {
    width: 12px;
    height: 12px;
  }
  .feature-item {
    gap: 3px;
  }
  .comp-row-content {
    gap: 3px;
    justify-content: center;
  }
  .comp-check {
    font-size: 0.80rem;
  }
  .comp-cross {
    font-size: 0.74rem;
  }
  .cta-row {
    gap: 8px;
    width: 100%;
  }
  .qty-control {
    height: 48px;
    flex-shrink: 0;
