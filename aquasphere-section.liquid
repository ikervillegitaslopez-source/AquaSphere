             <path d="M2 12h20"></path>
           </svg>
         </button>`
      : '';

    return `
      <div class="review-card">
        <div class="review-header">
          <div class="reviewer-meta">
            <img src="${avatarSrc}" alt="${r.name}" class="reviewer-avatar-img" loading="lazy" onerror="this.onerror=null; this.src='https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/avatars/dog-corgi.jpg';">
