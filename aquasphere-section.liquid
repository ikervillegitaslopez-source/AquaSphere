  function getAvatarUrl(avatarPath) {
    if (!avatarPath) return 'https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/avatars/dog-corgi.jpg';
    if (typeof window !== 'undefined' && window.AQUASPHERE_ASSET_BASE) {
      const filename = avatarPath.split('/').pop();
      return window.AQUASPHERE_ASSET_BASE + filename;
    }
    return avatarPath;
  }

  function getFlagSrc(r) {
    let flagPath = r.flag;
    if (!flagPath) {
      if (r.countryCode) {
        flagPath = `https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/flags/${r.countryCode.toLowerCase()}.svg`;
      } else if (r.countryName && COUNTRY_FLAG_MAP[r.countryName]) {
        flagPath = COUNTRY_FLAG_MAP[r.countryName];
      } else {
        flagPath = 'https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/flags/us.svg';
      }
    }
    if (typeof window !== 'undefined' && window.AQUASPHERE_ASSET_BASE) {
      const filename = flagPath.split('/').pop();
      return window.AQUASPHERE_ASSET_BASE + filename;
    }
    return flagPath;
  }

  function createReviewCardHTML(r) {
    const avatarSrc = getAvatarUrl(r.avatar);
    const flagSrc = getFlagSrc(r);
    const isTranslatable = r.lang && r.lang !== 'en' && r.translatedBody;
    const bodyText = (r.body || '').replace(/"/g, '&quot;');
    const transText = (r.translatedBody || r.body || '').replace(/"/g, '&quot;');

    // Only non-English reviews show the globe icon button; English reviews show nothing
    const headerActionHTML = isTranslatable
      ? `<button class="translate-btn" type="button" aria-label="Translate to English" title="Translate to English">
