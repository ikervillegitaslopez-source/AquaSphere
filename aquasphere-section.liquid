  }
  .rating-overview {
    border-right: none;
    border-bottom: 1px solid var(--slate-200);
    padding-right: 0;
    padding-bottom: 22px;
  }
  .reviews-grid {
    grid-template-columns: 1fr;
    max-width: 680px;
    margin: 0 auto;
    gap: 20px;
  }
  .review-card {
    padding: 20px 22px 16px 22px;
    border-radius: 16px;
  }
  .review-header {
    margin-bottom: 10px;
  }
  .review-body {
    font-size: 0.92rem;
    line-height: 1.64;
    margin: 0 0 14px 0;
  }
  .review-footer {
    padding-top: 11px;
  }
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
  .table-wrapper {
