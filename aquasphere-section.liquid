    padding-bottom: 22px;
  }
  .reviews-grid {
    grid-template-columns: 1fr;
    max-width: 680px;
    margin: 0 auto;
    gap: 20px;
  }
  .review-card {
    padding: 24px 26px;
    border-radius: 16px;
  }
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
  .table-wrapper {
    max-width: 740px;
    border-radius: 16px;
  }
  .comp-table th {
    padding: 14px 16px;
    font-size: 0.95rem;
  }
  .comp-table td {
    padding: 13px 16px;
    font-size: 0.88rem;
  }
  .comp-icon {
    width: 16px;
    height: 16px;
  }
  .comp-check {
    font-size: 1rem;
  }
  .comp-cross {
    font-size: 0.95rem;
  }
}

@media (max-width: 768px) {
  .pillars-grid {
    grid-template-columns: 1fr;
