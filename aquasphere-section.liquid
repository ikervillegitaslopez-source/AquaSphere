    padding: 26px 18px 24px;
    border-radius: 16px;
  }
  .pillar-line {
    font-size: clamp(0.70rem, 3.2vw, 0.86rem);
  }
  .steps-grid {
    grid-template-columns: 1fr;
    max-width: 100%;
    margin: 26px auto 0;
    gap: 16px;
  }
  .step-card {
    padding: 26px 18px 24px;
    border-radius: 16px;
  }
  .step-line {
    font-size: clamp(0.66rem, 2.7vw, 0.82rem);
  }
  .footer-grid {
    grid-template-columns: 1fr;
  }
  .nav-links {
    display: none;
  }
  .current-price {
    font-size: 1.9rem;
  }
  .sticky-title {
    display: none;
  }
  .comparison-section {
    padding: 44px 0;
  }
  .comp-header {
    margin-bottom: 18px;
  }
  .table-wrapper {
    border-radius: 14px;
    overflow: hidden;
    width: 100%;
    margin: 0 auto;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);
  }
  .comp-table {
    width: 100% !important;
