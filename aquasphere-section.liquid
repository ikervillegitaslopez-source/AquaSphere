  function getAvatarUrl(avatarPath) {
    if (!avatarPath) return 'https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/avatars/dog-corgi.jpg';
    if (typeof window !== 'undefined' && window.AQUASPHERE_ASSET_BASE) {
      const filename = avatarPath.split('/').pop();
      return window.AQUASPHERE_ASSET_BASE + filename;
    }
    return avatarPath;
  }

  function getFlagSrc(r) {
    let flagPath = r.flag;
    if (!flagPath) {
      if (r.countryCode) {
        flagPath = `https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/flags/${r.countryCode.toLowerCase()}.svg`;
      } else if (r.countryName && COUNTRY_FLAG_MAP[r.countryName]) {
        flagPath = COUNTRY_FLAG_MAP[r.countryName];
      } else {
        flagPath = 'https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/flags/us.svg';
      }
    }
    if (typeof window !== 'undefined' && window.AQUASPHERE_ASSET_BASE) {
      const filename = flagPath.split('/').pop();
      return window.AQUASPHERE_ASSET_BASE + filename;
    }
    return flagPath;
  }

  function createReviewCardHTML(r) {
    const avatarSrc = getAvatarUrl(r.avatar);
    const flagSrc = getFlagSrc(r);
    const isTranslatable = r.lang && r.lang !== 'en' && r.translatedBody;
    const bodyText = (r.body || '').replace(/"/g, '&quot;');
    const transText = (r.translatedBody || r.body || '').replace(/"/g, '&quot;');

    const headerActionHTML = isTranslatable
      ? `<button class="translate-btn" type="button" aria-label="Translate to English">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <circle cx="12" cy="12" r="10"></circle>
             <line x1="2" y1="12" x2="22" y2="12"></line>
             <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
           </svg>
           <span>Translate</span>
         </button>`
      : `<span class="lang-tag">EN</span>`;

    return `
      <div class="review-card">
        <div class="review-header">
          <div class="reviewer-meta">
            <img src="${avatarSrc}" alt="${r.name}" class="reviewer-avatar-img" loading="lazy" onerror="this.onerror=null; this.src='https://raw.githubusercontent.com/ikervillegitaslopez-source/AquaSphere/main/images/avatars/dog-corgi.jpg';">
            <div class="reviewer-info">
              <div class="reviewer-name-row">
                <span class="reviewer-name">${r.name}</span>
                <img src="${flagSrc}" alt="${r.countryName || 'Country'}" class="reviewer-flag-img" loading="lazy">
              </div>
              <div class="stars-row" style="font-size: 0.9rem;">${r.starsString || '★★★★★'}</div>
            </div>
          </div>
          ${headerActionHTML}
        </div>
        <div class="review-body" data-original="${bodyText}" data-translated="${transText}">
          "${r.body}"
        </div>
        <div class="review-footer">
          <span class="helpful-label">Was this review helpful?</span>
          <div class="helpful-actions">
            <button class="vote-btn like-btn" aria-label="Helpful review">
              <span class="vote-icon">👍</span> Like
            </button>
            <button class="vote-btn dislike-btn" aria-label="Not helpful review">
              <span class="vote-icon">👎</span> Dislike
            </button>
          </div>
        </div>
      </div>
    `;
  }

  function bindTranslationToCard(card) {
    const translateBtn = card.querySelector('.translate-btn');
    const bodyEl = card.querySelector('.review-body');
    if (!translateBtn || !bodyEl) return;

    translateBtn.addEventListener('click', () => {
      const isTranslated = translateBtn.classList.toggle('translated');
      const origText = bodyEl.getAttribute('data-original');
      const transText = bodyEl.getAttribute('data-translated');

      if (isTranslated) {
        bodyEl.textContent = `"${transText}"`;
        translateBtn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Original</span>
        `;
      } else {
        bodyEl.textContent = `"${origText}"`;
        translateBtn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>Translate</span>
        `;
      }
    });
  }

  function bindVotingToCard(card) {
    const likeBtn = card.querySelector('.like-btn');
    const dislikeBtn = card.querySelector('.dislike-btn');
    if (!likeBtn || !dislikeBtn) return;

    likeBtn.addEventListener('click', () => {
      if (likeBtn.classList.contains('voted')) {
        likeBtn.classList.remove('voted');
      } else {
        dislikeBtn.classList.remove('voted');
        likeBtn.classList.add('voted');
      }
    });

    dislikeBtn.addEventListener('click', () => {
      if (dislikeBtn.classList.contains('voted')) {
        dislikeBtn.classList.remove('voted');
      } else {
        likeBtn.classList.remove('voted');
        dislikeBtn.classList.add('voted');
      }
    });
  }

  // Bind voting and translation to all initially rendered cards
  if (reviewsGrid) {
    reviewsGrid.querySelectorAll('.review-card').forEach(card => {
      bindVotingToCard(card);
      bindTranslationToCard(card);
    });
  }

  function updateReviewsProgress() {
    if (currentCountEl) currentCountEl.textContent = currentlyShown;
    if (progressFill) {
      const pct = Math.min(100, Math.round((currentlyShown / TOTAL_REVIEWS) * 100));
      progressFill.style.width = `${pct}%`;
    }
    if (currentlyShown >= TOTAL_REVIEWS) {
      if (btnLoadMore) {
        btnLoadMore.textContent = 'All 248 Reviews Loaded ✓';
        btnLoadMore.disabled = true;
        btnLoadMore.style.opacity = '0.6';
        btnLoadMore.style.cursor = 'default';
      }
    }
  }

  function loadReviewsBatch(count) {
    if (!reviewsGrid || currentlyShown >= TOTAL_REVIEWS) return;
    const startIndex = currentlyShown;
    const endIndex = Math.min(TOTAL_REVIEWS, startIndex + count);

    const fragment = document.createDocumentFragment();
    for (let i = startIndex; i < endIndex; i++) {
      const reviewData = allReviews[i];
      if (!reviewData) continue;
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = createReviewCardHTML(reviewData);
      const newCard = tempDiv.firstElementChild;
      bindVotingToCard(newCard);
      bindTranslationToCard(newCard);
      fragment.appendChild(newCard);
    }
    reviewsGrid.appendChild(fragment);
    currentlyShown = endIndex;
    updateReviewsProgress();
  }

  if (btnLoadMore) {
    btnLoadMore.addEventListener('click', () => {
      loadReviewsBatch(10);
    });
  }

